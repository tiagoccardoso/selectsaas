# Banco Neon/PostgreSQL
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require"

# Autenticação
# E-mails separados por vírgula cadastrados como administradores automaticamente.
ADMIN_EMAILS="admin@seudominio.com"

# IA de suporte: DeepSeek é o padrão. Use AI_PROVIDER="openai" para alternar para OpenAI.
AI_PROVIDER="deepseek"
AI_MODEL=""
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_API_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_BASE_URL="https://api.openai.com/v1"

# URL pública da aplicação, útil para links de recuperação de senha e callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Envio de e-mail para recuperação de senha. Configure em produção com domínio remetente verificado.
RESEND_API_KEY=""
PASSWORD_RESET_EMAIL_FROM="SelectSaaS <no-reply@seudominio.com>"
